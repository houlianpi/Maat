    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@wdio/appium-service": "9.32.0",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/junit-reporter": "9.32.0",
    "@wdio/local-runner": "9.32.0",
    "@wdio/logger": "9.29.1",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "appium": "3.8.0",
    "expect-webdriverio": "6.1.0",
    "mocha": "10.8.2",
    "playwright": "1.58.2",
    "webdriverio": "9.32.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0"
  }
