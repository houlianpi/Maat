{
  "name": "@houlianpi/maat",
  "version": "0.3.2",
  "description": "Standalone UI execution Agent and TUI for Maat",
  "license": "MIT",
  "type": "module",
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "bin": {
    "maat": "bin/maat.mjs"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "node --experimental-strip-types --test ../../test/agent-options.test.ts ../../test/agent-trace.test.ts ../../test/cli-bin.test.ts ../../test/maat-tui.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@houlianpi/maat-core": "0.3.2",
    "@houlianpi/maat-pi": "0.3.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/houlianpi/Maat.git",
    "directory": "packages/maat"
  }
}
