{
  "name": "@houlianpi/maat-core",
  "version": "0.3.2",
  "description": "Host-neutral UI execution core for Maat",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "node --experimental-strip-types --test ../../test/connection-job-supervisor.test.ts ../../test/execution-errors.test.ts ../../test/javascript-session.test.ts ../../test/maat-api.test.ts ../../test/mixed-case.test.ts ../../test/platform-adapter.test.ts ../../test/native.test.ts ../../test/setup-assistant.test.ts ../../test/android-setup.test.ts ../../test/android-tools.test.ts ../../test/session-target-selection.test.ts ../../test/mobile-device-contract.test.ts",
    "test:android": "node --experimental-strip-types --test ../../test/android-tools.test.ts ../../test/android-setup.test.ts"
  },
  "dependencies": {
    "@wdio/globals": "9.31.3",
    "@wdio/logger": "9.29.1",
    "expect-webdriverio": "6.1.0",
    "playwright": "1.58.2",
    "typescript": "5.9.3",
    "yauzl": "3.4.0",
    "webdriverio": "9.32.0"
  },
  "devDependencies": {
    "@types/yauzl": "3.4.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/houlianpi/Maat.git",
    "directory": "packages/core"
  }
}
