{
  "name": "@houlianpi/maat-pi",
  "version": "0.3.2",
  "description": "Maat extension for Pi coding-agent",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "mobile-use",
    "playwright",
    "appium"
  ],
  "type": "module",
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "node --experimental-strip-types --test ../../test/exec-js-tool.test.ts ../../test/pi-extension.test.ts ../../test/pi-session-isolation.test.ts ../../test/setup-tools.test.ts ../../test/android-setup-tools.test.ts ../../test/android-tools-script.test.ts ../../test/setup-ui.test.ts ../../test/setup-skill.test.ts ../../test/setup-model-context.test.ts"
  },
  "dependencies": {
    "@houlianpi/maat-core": "0.3.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/houlianpi/Maat.git",
    "directory": "packages/pi"
  }
}
